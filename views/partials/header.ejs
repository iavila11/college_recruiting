<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Highlight Reel</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Highlight<span>Reel</span></a>
  <nav>
    <% if (currentUser) { %>
      <%# Core destinations only; everything else is one click away from the dashboard. %>
      <a href="/feed">Feed</a>
      <% if (currentUser.role === 'coach') { %><a href="/athletes">Find athletes</a><% } %>
      <a href="/messages">Messages<% if (unreadMessages) { %><span class="nav-badge" aria-label="<%= unreadMessages %> unread"><%= unreadMessages %></span><% } %></a>
      <a href="/dashboard">Dashboard</a>
      <% if (locals.isAdmin) { %><a href="/reports">Reports</a><% } %>
      <% if (currentUser.role === 'athlete') { %><a class="btn btn-small" href="/videos/new">Upload</a><% } %>
      <form method="post" action="/logout" class="inline"><button class="link">Log out</button></form>
    <% } else { %>
      <a href="/login">Log in</a>
      <a class="btn btn-small" href="/register">Sign up</a>
    <% } %>
  </nav>
</header>
<main>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
