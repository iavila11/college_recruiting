<%- include('partials/header') %>
<div class="thread">
  <p><a href="/dashboard">← Dashboard</a></p>
  <section class="card">
    <h1>Request a visit</h1>
    <p><a class="post-team" href="/coaches/<%= coach.id %>"><%= coach.name %></a><%= coach.title ? ', ' + coach.title : '' %><%= coach.school ? ' · ' + coach.school : '' %> opened their visit calendar to you.</p>
    <% if (coach.message) { %><p class="pre muted"><%= coach.message %></p><% } %>
    <% if (coach.video_title) { %><p class="small muted">Re: <a href="/videos/<%= coach.video_id %>"><%= coach.video_title %></a></p><% } %>
    <% if (current) { %>
      <p class="notice">
        <%= current.status === 'accepted' ? 'Your visit is scheduled for' : 'You requested' %>
        <strong><%= formatSlot(current.starts_at, current.duration_minutes) %></strong>.
        Pick a new time below to request a change; the coach will confirm it again.
      </p>
    <% } %>
  </section>

  <% if (!days.length) { %>
    <div class="card empty">
      <p>The coach has no other open times right now.</p>
      <p><a class="btn btn-secondary" href="/messages/new?coach=<%= coach.id %>">Message <%= coach.name %></a></p>
    </div>
  <% } else { %>
    <form method="post" action="/coaches/<%= coach.id %>/visit" class="form">
      <p class="muted small">Times are local time at campus.</p>
      <% days.forEach(function (d) { %>
        <fieldset class="day-group">
          <legend class="day-title"><%= d.day %></legend>
          <div class="slot-choices">
            <% d.slots.forEach(function (s) { var left = s.capacity - s.booked; %>
              <label class="slot-choice">
                <input type="radio" name="slot_id" value="<%= s.id %>" required>
                <span>
                  <strong><%= formatTimeRange(s.starts_at, s.duration_minutes) %></strong>
                  <% if (s.location) { %><span class="small muted"><%= s.location %></span><% } %>
                  <% if (s.capacity > 1) { %><span class="small muted"><%= left %> spot<%= left === 1 ? '' : 's' %> left</span><% } %>
                </span>
              </label>
            <% }) %>
          </div>
        </fieldset>
      <% }) %>
      <label>Note to the coach (optional) <input name="message" maxlength="1000" placeholder="Looking forward to it! My parents will join me."></label>
      <button class="btn">Request this time</button>
    </form>
  <% } %>
</div>
<%- include('partials/footer') %>
