<%- include('partials/header') %>
<div class="calendar-layout">
  <section>
    <h1>Visit calendar</h1>
    <p class="muted">Your calendar is private. Add the times you can host visits, then open it to the athletes you're interested in by their Athlete ID. Only those athletes can request your open times, and you confirm each request on <a href="/dashboard">your dashboard</a>.</p>
    <% if (!days.length) { %><p class="card muted">No upcoming visit times. Add one to get started.</p><% } %>
    <% days.forEach(function (d) { %>
      <h2 class="day-title"><%= d.day %></h2>
      <% d.slots.forEach(function (s) { var full = s.booked >= s.capacity; %>
        <div class="card slot-row">
          <div class="grow">
            <strong><%= formatTimeRange(s.starts_at, s.duration_minutes) %></strong>
            <% if (s.location) { %><div class="small muted"><%= s.location %></div><% } %>
            <div class="small">
              <span class="status status-<%= full ? 'accepted' : 'pending' %>"><%= full ? 'Full' : 'Open' %></span>
              <%= s.booked %> of <%= s.capacity %> booked<% if (s.athletes.length) { %>:
                <% s.athletes.forEach(function (a, i) { %><a href="/athletes/<%= a.athlete_id %>"><%= a.athlete_name %></a><%= i < s.athletes.length - 1 ? ', ' : '' %><% }) %>
              <% } %>
              <% if (s.requested) { %> · <a href="/dashboard"><%= s.requested %> request<%= s.requested === 1 ? '' : 's' %> waiting</a><% } %>
            </div>
          </div>
          <% if (!s.booked) { %>
            <form method="post" action="/calendar/slots/<%= s.id %>/delete" class="inline">
              <button class="btn btn-secondary btn-small">Remove</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    <% }) %>
  </section>

  <aside>
    <div class="card">
      <h2 class="side-title">Add an open time</h2>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="/calendar/slots" class="form">
        <label>Date and start time <input type="datetime-local" name="starts_at" required min="<%= minStart %>" value="<%= form.starts_at || '' %>"></label>
        <div class="row">
          <label>Length
            <select name="duration_minutes">
              <% [[30, '30 min'], [60, '1 hour'], [90, '1.5 hours'], [120, '2 hours'], [180, '3 hours'], [240, '4 hours'], [480, 'Full day']].forEach(function (o) { %>
                <option value="<%= o[0] %>" <%= String(form.duration_minutes || 120) === String(o[0]) ? 'selected' : '' %>><%= o[1] %></option>
              <% }) %>
            </select>
          </label>
          <label>Athletes <input type="number" name="capacity" min="1" max="50" value="<%= form.capacity || 1 %>"></label>
        </div>
        <label>Location / notes <input name="location" maxlength="300" value="<%= form.location || '' %>" placeholder="Meet at the athletics center front desk"></label>
        <p class="muted small">Times are local time at your campus.</p>
        <button class="btn">Add time</button>
      </form>
    </div>
    <div class="card" id="access">
      <h2 class="side-title">Open your calendar to an athlete</h2>
      <% if (accessError) { %><p class="error"><%= accessError %></p><% } %>
      <form method="post" action="/calendar/access" class="form">
        <label>Athlete ID <input name="athlete_code" required maxlength="60" value="<%= accessForm.athlete_code %>" placeholder="e.g. NCAA-2027-0042" class="athlete-id"></label>
        <label>Message (optional) <textarea name="message" rows="3" placeholder="Introduce yourself and your program, and why you'd like them to visit."><%= accessForm.message %></textarea></label>
        <button class="btn">Open calendar</button>
      </form>
      <p class="muted small">Athletes list their Athlete ID on their profile. Only athletes you open your calendar to can request visits.</p>
    </div>
    <div class="card">
      <h2 class="side-title">Athletes who can request visits</h2>
      <% if (!access.length) { %><p class="muted small">Nobody can request visits yet.</p><% } %>
      <% access.forEach(function (a) { %>
        <div class="access-row">
          <div class="grow">
            <a href="/athletes/<%= a.athlete_id %>"><%= a.name %></a>
            <div class="small muted"><span class="athlete-id"><%= a.athlete_code || 'No ID' %></span><%= a.sport ? ' · ' + a.sport : '' %><%= a.position ? ' · ' + a.position : '' %></div>
            <div class="small">
              <% if (!a.request) { %><span class="status status-declined">No request yet</span>
              <% } else if (a.request.status === 'accepted') { %><span class="status status-accepted">Scheduled</span> <%= formatSlot(a.request.starts_at, a.request.duration_minutes) %>
              <% } else { %><span class="status status-pending">Requested</span> <%= formatSlot(a.request.starts_at, a.request.duration_minutes) %><% } %>
            </div>
          </div>
          <form method="post" action="/calendar/access/<%= a.athlete_id %>/revoke" class="inline" onsubmit="return confirm('Stop this athlete from requesting visits? Confirmed visits stay on your calendar.')">
            <button class="btn btn-secondary btn-small">Close</button>
          </form>
        </div>
      <% }) %>
    </div>
  </aside>
</div>
<%- include('partials/footer') %>
